# Copy this file to .env.local for local development, and set the same
# variables as real environment variables in your hosting dashboard
# (Vercel / Netlify) for production. Never commit actual secret values.

# Shared password for the three gated case studies
# (Cash Loan UX, Tida Retail, Affordability Screen).
CASE_STUDY_PASSWORD=

# Random secret used to sign the session cookie issued after a correct
# password is entered. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates all existing unlocked sessions.
AUTH_SECRET=
